# Pegasus Mission OS environment configuration.
# Copy to `.env.local` for local development. Never commit real secrets.

# Public application URL (used for absolute links and redirects).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (optional) ---
# When these are unset the app runs in MOCK mode with an in-memory seeded
# workspace. Set them to connect a real Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never exposed to the browser. Used for admin/seed operations.
SUPABASE_SERVICE_ROLE_KEY=

# --- Contact form ---
# Where landing-page enquiries are delivered. Accepts any endpoint that takes a
# JSON POST: a Zapier/Make catch hook, a Slack or Teams incoming webhook, or
# your own route. WHEN THIS IS UNSET THERE IS NO DELIVERY: enquiries are only
# written to the server log, so set it before pointing real traffic at the form.
ENQUIRY_WEBHOOK_URL=

# --- AI provider ---
# AI_PROVIDER: "mock" (default, deterministic, no network) or "anthropic".
AI_PROVIDER=mock
# Server-only. Required when AI_PROVIDER=anthropic. Never exposed to the browser.
ANTHROPIC_API_KEY=

# Model tiers. Most of what Pegasus knows is computed, not generated — fit,
# grant health, evidence strength and every finance figure are deterministic —
# so the model usually only has to phrase facts it was handed. That runs on the
# cheap tier. The higher tier is used for the two features a funder reads:
# grant application answers and impact report sections.
#
# Approximate cost per organisation per year at typical usage:
#   routine everywhere            ~£4
#   split (the default below)     ~£8
#   highest tier everywhere       ~£20
# Model choice is not this product's cost driver. Change these only with
# measured evidence, not to save pennies.
AI_MODEL_ROUTINE=claude-haiku-4-5
AI_MODEL_FUNDER_FACING=claude-sonnet-5
