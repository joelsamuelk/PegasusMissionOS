# Pegasus Mission OS environment configuration.
# Copy to `.env.local` for local development. Never commit real secrets.

# Public application URL (used for absolute links and redirects).
NEXT_PUBLIC_APP_URL=http://app.localhost:3000

# Public marketing site URL. Drives metadataBase, canonical URLs, the sitemap
# and Organisation/Product structured data. Kept separate from the app URL
# because the two are different hosts in production.
NEXT_PUBLIC_MARKETING_URL=http://mission.localhost:3000

# The parent company site, linked from the marketing site and structured data.
NEXT_PUBLIC_STUDIO_URL=https://www.pegasus-studio.co/

# --- Supabase (optional) ---
# When these are unset the app runs in MOCK mode with an in-memory seeded
# workspace. Set the URL and one public key to enable Supabase magic-link auth.
NEXT_PUBLIC_SUPABASE_URL=
# Current Supabase projects call this the publishable key. The legacy anon key
# remains supported as a fallback; do not set both unless rotating keys.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never exposed to the browser. Used for admin/seed operations.
SUPABASE_SERVICE_ROLE_KEY=

# Separate internal application origin.
NEXT_PUBLIC_CONTROL_URL=http://control.localhost:3000
# Optional all-in-one origins used for branch previews and a staged migration.
# VERCEL_URL is detected automatically; set these for other hosting platforms.
NEXT_PUBLIC_PREVIEW_URL=
NEXT_PUBLIC_LEGACY_URL=
GOOGLE_SITE_VERIFICATION=
CONTROL_PLANE_MOCK=false

# --- Commercial discovery providers (server-only) ---
# Public-web discovery for announcements, reports, careers and change signals.
BRAVE_SEARCH_API_KEY=
# Authoritative UK company identity and registry corroboration.
COMPANIES_HOUSE_API_KEY=
# Authoritative England and Wales charity register access.
CHARITY_COMMISSION_API_KEY=

# --- System email ---
SYSTEM_EMAIL_PROVIDER=none
SYSTEM_EMAIL_FROM=Pegasus <hello@pegasus-studio.co>
SYSTEM_EMAIL_REPLY_TO=hello@pegasus-studio.co
OUTREACH_EMAIL_PROVIDER=resend
OUTREACH_EMAIL_FROM=Joël at Pegasus <joel@pegasus-studio.co>
OUTREACH_EMAIL_REPLY_TO=joel@pegasus-studio.co
OUTREACH_SENDER_NAME=Joël Samuel
OUTREACH_SENDER_ROLE=Founder
OUTREACH_POSTAL_ADDRESS=Exeter, Devon, United Kingdom

# --- Contact form ---
# Direct email delivery. Create an API key at Resend and verify the sender
# domain before production. The visitor's address is set as Reply-To.
RESEND_API_KEY=
ENQUIRY_EMAIL_TO=joel@pegasus-studio.co
ENQUIRY_EMAIL_FROM=Pegasus Mission OS <hello@pegasus-studio.co>
# Optional fallback when Resend is not configured. Accepts any endpoint taking
# a JSON POST, such as Zapier, Make or your own route. When neither channel is
# configured the form returns an error rather than claiming success.
ENQUIRY_WEBHOOK_URL=

# --- AI provider ---
# AI_PROVIDER: "mock" (default, deterministic, no network) or "anthropic".
AI_PROVIDER=mock
# Server-only. Required when AI_PROVIDER=anthropic. Never exposed to the browser.
ANTHROPIC_API_KEY=

# Model tiers. Most of what Pegasus knows is computed, not generated — fit,
# grant health, evidence strength and every finance figure are deterministic —
# so the model usually only has to phrase facts it was handed. That runs on the
# cheap tier. The higher tier is used for the two features a funder reads:
# grant application answers and impact report sections.
#
# Approximate cost per organisation per year at typical usage:
#   routine everywhere            ~£4
#   split (the default below)     ~£8
#   highest tier everywhere       ~£20
# Model choice is not this product's cost driver. Change these only with
# measured evidence, not to save pennies.
AI_MODEL_ROUTINE=claude-haiku-4-5
AI_MODEL_FUNDER_FACING=claude-sonnet-5
